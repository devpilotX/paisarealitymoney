# Paisa Reality price update. Installed by deploy/vps/setup-app.sh.
# The CRON_SECRET is read at runtime by the script from /etc/paisareality/paisareality.env
# and sent as a header, so it is never in this unit or in an access log.
[Unit]
Description=Paisa Reality price update
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=paisa
ExecStart=/usr/local/bin/paisareality-price-cron
StandardOutput=append:/var/log/paisareality/cron.log
StandardError=append:/var/log/paisareality/cron.log
